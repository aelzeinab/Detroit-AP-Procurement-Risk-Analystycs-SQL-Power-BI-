-- Database: PostgreSQL
-- Purpose: Detect vendor risk patterns (duplicates, threshold splitting, overpay flags)

--Top 25 Vendors By Total Spend
SELECT
  vendor_name,
  ROUND(SUM(check_amount), 2) AS total_spend
FROM detroit.raw_payments_clean
WHERE vendor_name IS NOT NULL
GROUP BY vendor_name
ORDER BY total_spend DESC
LIMIT 25;

--Duplicate Payments For Top Vendors
SELECT
  vendor_name,
  check_amount,
  COUNT(*) AS num_payments,
  MIN(check_date) AS first_date,
  MAX(check_date) AS last_date
FROM detroit.raw_payments_clean
WHERE vendor_name IS NOT NULL
  AND check_amount IS NOT NULL
GROUP BY vendor_name, check_amount
HAVING COUNT(*) >= 2
ORDER BY num_payments DESC, check_amount DESC
LIMIT 50;

--Payments Near $10,000 Threshold (possible split payments)
SELECT
  vendor_name,
  fiscal_year,
  COUNT(*) AS payments_between_9k_10k,
  ROUND(SUM(check_amount), 2) AS total_between_9k_10k
FROM detroit.raw_payments_clean
WHERE check_amount BETWEEN 9000 AND 9999.99
GROUP BY vendor_name, fiscal_year
HAVING COUNT(*) >= 3
ORDER BY total_between_9k_10k DESC
LIMIT 50;

--Top Vendor Contracts
SELECT
  supplier,
  contract_number,
  amount,
  start_date,
  end_date,
  status,
  po_type,
  city,
  state
FROM detroit.raw_contracts_clean
WHERE amount IS NOT NULL
ORDER BY amount DESC
LIMIT 25;

--Payments vs Contract Amount (Flag for any Overpay)
SELECT
  c.supplier,
  ROUND(SUM(p.check_amount),2) AS total_paid,
  ROUND(MAX(c.amount),2) AS contract_amount,
  ROUND(SUM(p.check_amount) - MAX(c.amount),2) AS paid_minus_contract,
  COUNT(*) AS num_payments
FROM detroit.raw_contracts_clean c
JOIN detroit.raw_payments_clean p
  ON UPPER(TRIM(p.vendor_name)) = UPPER(TRIM(c.supplier))
WHERE p.check_amount IS NOT NULL
  AND c.amount IS NOT NULL
GROUP BY c.supplier
HAVING SUM(p.check_amount) > MAX(c.amount)
ORDER BY paid_minus_contract DESC
LIMIT 50;

--Contracts Expiring Soon (Procurement Insight)
SELECT
  supplier,
  contract_number,
  amount,
  end_date,
  status
FROM detroit.raw_contracts_clean
WHERE end_date IS NOT NULL
ORDER BY end_date ASC
LIMIT 50;

--Final Vendor Risk Score Model
WITH vendor_spend AS (
  SELECT
    vendor_name AS vendor,
    SUM(check_amount) AS total_spend,
    COUNT(*) AS payment_count
  FROM detroit.raw_payments_clean
  WHERE check_amount IS NOT NULL AND vendor_name IS NOT NULL
  GROUP BY vendor_name
),
near_threshold AS (
  SELECT
    vendor_name AS vendor,
    COUNT(*) AS near_10k_count
  FROM detroit.raw_payments_clean
  WHERE check_amount BETWEEN 9000 AND 9999.99
    AND vendor_name IS NOT NULL
  GROUP BY vendor_name
),
dup_amounts AS (
  SELECT
    vendor_name AS vendor,
    COUNT(*) AS duplicate_groups
  FROM (
    SELECT vendor_name, check_amount
    FROM detroit.raw_payments_clean
    WHERE vendor_name IS NOT NULL AND check_amount IS NOT NULL
    GROUP BY vendor_name, check_amount
    HAVING COUNT(*) >= 2
  ) d
  GROUP BY vendor_name
),
contract_overpay AS (
  SELECT
    c.supplier AS vendor,
    SUM(p.check_amount) - MAX(c.amount) AS overpaid_amount
  FROM detroit.raw_contracts_clean c
  JOIN detroit.raw_payments_clean p
    ON UPPER(TRIM(p.vendor_name)) = UPPER(TRIM(c.supplier))
  WHERE p.check_amount IS NOT NULL
    AND c.amount IS NOT NULL
  GROUP BY c.supplier
  HAVING SUM(p.check_amount) > MAX(c.amount)
)
SELECT
  s.vendor,
  ROUND(s.total_spend,2) AS total_spend,
  s.payment_count,
  COALESCE(t.near_10k_count,0) AS near_10k_count,
  COALESCE(d.duplicate_groups,0) AS duplicate_groups,
  ROUND(COALESCE(o.overpaid_amount,0),2) AS overpaid_amount,

  (
    COALESCE(t.near_10k_count,0) * 2 +
    COALESCE(d.duplicate_groups,0) * 1 +
    CASE WHEN COALESCE(o.overpaid_amount,0) > 0 THEN 5 ELSE 0 END
  ) AS risk_score

FROM vendor_spend s
LEFT JOIN near_threshold t ON s.vendor = t.vendor
LEFT JOIN dup_amounts d ON s.vendor = d.vendor
LEFT JOIN contract_overpay o ON s.vendor = o.vendor
ORDER BY risk_score DESC, total_spend DESC
LIMIT 50;
